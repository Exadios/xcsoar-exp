# This is the cross compile definition for the meson "Unix 64 bit" target.

[binaries]
#c   = 'clang'
#cpp = 'clang++'
c   = [ 'ccache', 'cc' ]
cpp = [ 'ccache', 'c++' ]
#pkg-config = '/usr/bin/arm-linux-gnueabihf-pkg-config'
#pkg-config = '${HOME}/tmp/pkg-config'
c_ld = 'lld'
cpp_ld = 'lld'

[build_machine]
system = 'windows'
cpu_family = 'x86'
cpu = 'i686'
endian = 'little'

[built-in options]
#[properties]
cpp_args  = [
             '-flto',
             '-funit-at-a-time',
             '-ffast-math',
             '-fno-threadsafe-statics',
             '-fmerge-all-constants',
             '-fno-operator-names',
             '-fvisibility=hidden',
             '-finput-charset=utf-8',
             '-Wwrite-strings',
             '-Wcast-qual',
             '-Wpointer-arith',
             '-Wsign-compare',
             '-Wmissing-declarations',
             '-Wredundant-decls',
             '-Wvla',
             '-Wno-missing-field-initializers',
             '-Wcast-align',
             '-Wno-error=non-virtual-dtor',
             '-Wno-unused-parameter',
             '-Wno-non-virtual-dtor', # Meson insists on having -Wnon-virtual-dtor
             '-Wno-undef',  # This should not be. It is necessary to fix a problem in Boost.
             '-Wno-unused-parameter', # More Boost problems.
             '-DBOOST_NO_STDLIB_CONFIG',  # Stop Boost headers doing
                                          # crazy stuff with our
                                          # defines given here.
             '-DBOOST_FT_AUTODETECT_CALLING_CONVENTIONS',
             '-DBOOST_NO_IOSTREAM',
             '-DBOOST_MATH_NO_LEXICAL_CAST',
             '-DBOOST_UBLAS_NO_STD_CERR',
             '-DBOOST_ERROR_CODE_HEADER_ONLY',
             '-DBOOST_SYSTEM_NO_DEPRECATED',
             '-DBOOST_NO_STD_LOCALE',
             '-DBOOST_LEXICAL_CAST_ASSUME_C_LOCALE',
             '-DBOOST_NO_CXX98_FUNCTION_BASE',
             '-DBOOST_JSON_STANDALONE',
             '-DHAVE_POSIX',
             '-DHAVE_VASPRINTF',
             '-DEYE_CANDY',
             '-D_GLIBCXX_ASSERTIONS',
             '-DENABLE_ALSA',
             '-DUSE_FREETYPE',
             '-DENABLE_OPENGL',
             '-DHAVE_GLES',
             '-DHAVE_GLES2',
             '-isystem lib/glm',
             '-DGL_GLEXT_PROTOTYPES',
             '-DUSE_GLX',
             '-DUSE_X11',
             '-DUSE_POLL_EVENT',
             '-isystem /usr/include/x86_6-linux-gnu',
             '-isystem /usr/include/x86_6-linux-gnu',
             '-isystem /usr/include/lua5.4',
             '-isystem /usr/include/freetype2/',
             '-isystem output/src/boost_1_80_0',
             '-g3',
            ]

